{
  "name": "mwananchi",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "mysql:setup": "node scripts/mysql-local.mjs setup",
    "mysql:start": "node scripts/mysql-local.mjs start",
    "mysql:stop": "node scripts/mysql-local.mjs stop",
    "test:smoke": "node scripts/smoke-local.mjs",
    "dev": "concurrently -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "test": "npm run test -w server && npm run test -w client",
    "test:integration": "npm run test:integration -w server",
    "lint": "eslint client/src server scripts",
    "format": "prettier --write client/src server README.md docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
